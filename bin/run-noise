#!/usr/bin/env ruby

# Prerequisite: FFmpeg installed!
Thread.abort_on_exception = true

# URI of CDN
URL = 'https://broadcastify.cdnstream1.com'.freeze

# ID's of Police or Fire Dept. public feeds
# Check list and populate this array to use other
# feeds here (https://www.broadcastify.com/listen/top)
# 1189  -> NYPD Bronx/Manhattan Transit
# 6007  -> Jefferson County Police, Fire and EMS
# 26933 -> Buffalo Police, Fire and EMS
FEED_IDS = [1189, 6007, 26933]

begin
  FEED_IDS.map { |id| Thread.new { system("ffplay -vn -nodisp #{URL}/#{id}") } }.each(&:join)
rescue Interrupt
  3.times { puts }
  puts 'Shutting down all broadcasts!'
end
